{
  "name": "o-route",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vike build",
    "preview": "vite preview --host",
    "format": "eslint src --fix && prettier --write src",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run format && npm run test:unit && npm run test:e2e && npm run build",
    "emulators": "firebase emulators:start --only database,storage",
    "dev:emulator": "firebase emulators:exec --only database,storage --ui 'VITE_USE_FIREBASE_EMULATOR=true npm run dev'",
    "e2e:server": "firebase emulators:exec --only database,storage 'VITE_USE_FIREBASE_EMULATOR=true vite --host --port 3000'",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "typecheck:screenshots": "tsc -p tsconfig.screenshots.json",
    "screenshots:map": "node scripts/screenshots/generate-sample-map.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.12.1",
    "firebase": "^11.10.0",
    "immutable": "^4.3.0",
    "konva": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-konva": "^18.2.7",
    "use-image": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.0.0",
    "typescript": "^5.1.6",
    "vike": "^0.4.268",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "postcss": "^8.5.32",
    "nanoid": "^3.3.20",
    "brace-expansion": "^2.1.7",
    "@grpc/grpc-js": "^1.14.7"
  }
}
